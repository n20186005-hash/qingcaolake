---
import { SITE } from '../data/site';
import { getImage } from 'astro:assets';
import { IMAGES } from '../data/images';

interface Props {
  title: string;
  description: string;
  /** 頁面路徑，例如 /parking/ */
  path: string;
  /** OG 圖片 key，預設用 hero */
  ogImage?: keyof typeof IMAGES;
  type?: 'website' | 'article';
  /** 額外 JSON-LD 物件（會與預設的 WebSite/Organization 併入） */
  jsonld?: object[];
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  ogImage = 'hero',
  type = 'website',
  jsonld = [],
  noindex = false,
} = Astro.props;

const canonical = new URL(path, SITE.url).href;

// 產生 OG 圖（1200x630）
const og = await getImage({
  src: IMAGES[ogImage].src,
  width: 1200,
  height: 630,
  format: 'jpg',
});
const ogUrl = new URL(og.src, SITE.url).href;

// 全站共用結構化資料
const baseJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    alternateName: SITE.nameEn,
    url: SITE.url,
    inLanguage: 'zh-Hant-TW',
    description: SITE.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    alternateName: SITE.nameEn,
    url: SITE.url,
    email: SITE.email,
    description:
      '獨立經營的新竹青草湖遊客資訊網站，提供交通、停車、環湖步道、水上活動與路線指南。並非官方單位。',
    logo: new URL('/favicon.svg', SITE.url).href,
  },
  ...jsonld,
];
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta name="theme-color" content="#1f5c4d" />
<meta name="author" content={SITE.name} />
<meta name="generator" content={Astro.generator} />

<!-- hreflang：單一台灣繁中版本 -->
<link rel="alternate" hreflang="zh-Hant-TW" href={canonical} />
<link rel="alternate" hreflang="x-default" href={canonical} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="zh_TW" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />

<!-- Icons -->
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />

<link rel="preconnect" href={SITE.url} />

<script type="application/ld+json" set:html={JSON.stringify(baseJsonLd)} is:inline />
