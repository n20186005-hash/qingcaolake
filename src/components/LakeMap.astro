---
// 原創青草湖導覽示意地圖（非等比、非官方測繪，僅示意動線與相對位置）
interface Props { showLegend?: boolean; }
const { showLegend = true } = Astro.props;

const points = [
  { n: 1, x: 150, y: 470, label: '青草湖停車場' },
  { n: 2, x: 250, y: 405, label: '水域遊憩中心' },
  { n: 3, x: 205, y: 445, label: '公共廁所' },
  { n: 4, x: 300, y: 390, label: '浮水碼頭' },
  { n: 5, x: 375, y: 330, label: '映月橋' },
  { n: 6, x: 455, y: 300, label: '於飛島' },
  { n: 7, x: 420, y: 258, label: '心心相映亭' },
  { n: 8, x: 590, y: 235, label: '鳳凰橋' },
  { n: 9, x: 250, y: 175, label: '靈隱寺' },
  { n: 10, x: 630, y: 380, label: '明湖公園' },
  { n: 11, x: 500, y: 360, label: '推薦攝影點' },
  { n: 12, x: 340, y: 415, label: '推車友善路段' },
];
---
<figure class="map-figure">
  <svg viewBox="0 0 780 560" role="img"
       aria-labelledby="mapTitle mapDesc" xmlns="http://www.w3.org/2000/svg">
    <title id="mapTitle">青草湖導覽示意地圖</title>
    <desc id="mapDesc">標示停車場、水域遊憩中心、映月橋、於飛島、鳳凰橋、靈隱寺、明湖公園與三條推薦環湖路線的相對位置示意圖。</desc>

    <!-- 綠地底 -->
    <rect x="0" y="0" width="780" height="560" fill="#e7efe6" />
    <path d="M40 40 Q120 20 210 60 T420 40 640 70 740 120 720 300 700 470 560 520 300 530 120 500 40 400 Z"
          fill="#dCe8d6" opacity="0.6" />

    <!-- 山林（靈隱寺側） -->
    <path d="M120 60 l60 90 l60 -90 l55 100 l40 -70 Z" fill="#c7d7c0" opacity="0.7" />

    <!-- 湖面 -->
    <path d="M300 380
             C240 360 210 300 250 250
             C290 200 380 200 430 220
             C500 175 600 190 630 250
             C660 310 610 370 540 380
             C470 400 360 405 300 380 Z"
          fill="#bcd8d0" stroke="#8fb9ae" stroke-width="2" />
    <!-- 湖面波紋 -->
    <path d="M320 330 q30 -12 60 0 t60 0 t60 0" fill="none" stroke="#a5cabf" stroke-width="2" opacity="0.7" />
    <path d="M340 355 q30 -10 60 0 t60 0" fill="none" stroke="#a5cabf" stroke-width="2" opacity="0.5" />

    <!-- 河道（往鳳凰橋） -->
    <path d="M620 260 C660 250 680 240 700 210" fill="none" stroke="#bcd8d0" stroke-width="14" stroke-linecap="round" />

    <!-- 路線：一小時（金色） -->
    <path d="M150 470 L250 405 L375 330 L455 300"
          fill="none" stroke="#c98a2b" stroke-width="4" stroke-linecap="round"
          stroke-dasharray="1 10" />
    <!-- 路線：兩小時環湖（深綠） -->
    <path d="M150 470 L375 330 L455 300 Q560 280 590 235 Q660 300 630 380"
          fill="none" stroke="#1f5c4d" stroke-width="3.5" stroke-linecap="round"
          stroke-dasharray="2 9" opacity="0.85" />

    <!-- 橋 -->
    <line x1="355" y1="345" x2="400" y2="315" stroke="#8a6a3a" stroke-width="5" stroke-linecap="round" />
    <line x1="575" y1="245" x2="605" y2="225" stroke="#a2412f" stroke-width="5" stroke-linecap="round" />

    <!-- 於飛島 -->
    <ellipse cx="455" cy="300" rx="26" ry="18" fill="#cfe0c6" stroke="#8fb9ae" stroke-width="1.5" />

    <!-- 標點 -->
    {points.map((p) => (
      <g>
        <circle cx={p.x} cy={p.y} r="13" fill="#1f5c4d" stroke="#fff" stroke-width="2" />
        <text x={p.x} y={p.y + 4.5} text-anchor="middle" font-size="13" font-weight="700" fill="#fff">{p.n}</text>
      </g>
    ))}

    <!-- 標籤（重點） -->
    <text x="375" y="322" text-anchor="middle" font-size="13" font-weight="700" fill="#23372f">映月橋</text>
    <text x="455" y="332" text-anchor="middle" font-size="13" font-weight="700" fill="#23372f">於飛島</text>
    <text x="590" y="222" text-anchor="middle" font-size="13" font-weight="700" fill="#23372f">鳳凰橋</text>
    <text x="250" y="162" text-anchor="middle" font-size="13" font-weight="700" fill="#23372f">靈隱寺</text>
    <text x="640" y="400" text-anchor="middle" font-size="13" font-weight="700" fill="#23372f">明湖公園</text>

    <!-- 圖例（路線） -->
    <g transform="translate(40 510)">
      <line x1="0" y1="0" x2="34" y2="0" stroke="#c98a2b" stroke-width="4" stroke-dasharray="1 10" stroke-linecap="round" />
      <text x="42" y="4" font-size="13" fill="#5f6b62">一小時精華路線</text>
      <line x1="230" y1="0" x2="264" y2="0" stroke="#1f5c4d" stroke-width="3.5" stroke-dasharray="2 9" stroke-linecap="round" />
      <text x="272" y="4" font-size="13" fill="#5f6b62">兩小時環湖路線</text>
    </g>

    <text x="740" y="545" text-anchor="end" font-size="11" fill="#9aa89f">示意圖 · 非等比 · QingcaoLake.com</text>
  </svg>

  {showLegend && (
    <div class="map-legend" aria-label="地圖圖例">
      {points.map((p) => (
        <span><span class="pin">{p.n}</span>{p.label}</span>
      ))}
    </div>
  )}
</figure>
